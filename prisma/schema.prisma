// QuickMark 数据库 schema (Prisma 定义)
// 与 db/schema.sql + db/migration_v2_hierarchical.sql 保持字段/类型/约束一致
// 阶段 4 启用: 加 User.notes / User.categories 反向关系, Note.userId / Category.userId
// 注意: Prisma 5.x 自动创建 prisma_migrations 表 (运维/审计), 不需手写

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  // 显式声明字符集, 避免 Prisma 默认 Latin1 (中文/Emoji 全乱码)
  relationMode = "foreignKeys"
}

// ===== 分类表 (多级) =====
// v1: id / name / color / created_at / updated_at / (uk_name)
// v2 改造: 加 parent_id 自引用 FK, 删 uk_name, 加 (parent_id, name) 复合索引
// v3 改造: 加 user_id, 鉴权后多用户隔离
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  color     String?  @default("#6366f1") @db.VarChar(7)
  parentId  Int?     @map("parent_id")
  userId    Int      @map("user_id")
  position  Int      @default(0) @map("position")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // 自引用: 父分类删除时, 子分类一并删除 (级联)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryTree")

  // 多用户隔离: 用户删除 → 分类一并删除 (级联)
  owner User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 反向关联: 哪些笔记挂在这个分类下
  notes NoteCategory[]

  // 索引
  @@index([parentId, name], name: "idx_parent_name")
  @@index([userId], name: "idx_user_id")
  @@map("categories")
}

// ===== 笔记表 =====
model Note {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(255)
  content   String?  @db.Text
  isPinned  Boolean  @default(false) @map("is_pinned")
  position  Int      @default(0) @map("position")
  userId    Int      @map("user_id")
  // 掌握度 0-5 (间隔重复功能用, 驱动知识图谱着色); 功能关闭时恒为 0/NULL, 不影响其他逻辑
  mastery   Int?     @default(0) @map("mastery")
  // 计划甘特表: 起止日期、进度、颜色 (JSON, 如 { start: "2026-08-01", end: "2026-08-15", progress: 60, color: "#ff6b6b" })
  planData  Json?    @map("plan_data")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // 多用户隔离: 用户删除 → 笔记一并删除
  owner User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 反向关联: 笔记挂哪些分类
  categories NoteCategory[]
  // 反向关联: 笔记对应的复习卡 (间隔重复功能, 笔记级粒度)
  reviewCards ReviewCard[]

  @@index([userId], name: "idx_user_id")
  // FULLTEXT 索引 (title, content) 经 ngram 解析器支持中文, 由迁移
  // prisma/migrations/20260725000000_fulltext_ngram/migration.sql 创建 (Prisma 不直接支持 FT)
  @@map("notes")
}

// ===== 笔记-分类关联表 (多对多) =====
model NoteCategory {
  noteId     Int @map("note_id")
  categoryId Int @map("category_id")

  // FK: 笔记删除 → 关联记录一并删; 分类删除 → 关联记录一并删
  note     Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([noteId, categoryId])
  @@index([categoryId], name: "idx_category_id")
  @@map("note_categories")
}

// ===== 用户表 =====
// 阶段 4 鉴权启用; 默认账号 admin / admin123 (在 4.5 注册时写库, 或手动 SQL 兜底)
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(50)
  email        String?  @unique @db.VarChar(255)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  // 找回密码: 存 token 的 SHA-256 哈希 (不存明文, 防 DB 泄露被直接利用), 过期时间
  passwordResetToken  String?   @map("password_reset_token") @db.VarChar(255)
  passwordResetExpires DateTime? @map("password_reset_expires")
  displayName  String?  @map("display_name") @db.VarChar(100)
  role         String   @default("user") @db.VarChar(20) // "admin" / "user"
  isLocked     Boolean  @default(false) @map("is_locked")
  settings     Json?    @map("settings") // 用户偏好 / 功能开关, 如 { features: { spacedRepetition: true } }
  reviewStreak Int      @default(0) @map("review_streak")     // 连续复习打卡天数
  lastReviewDate DateTime? @map("last_review_date")           // 最近一次复习日期(本地日), 用于 streak
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  notes      Note[]
  categories Category[]
  feedbacks  Feedback[]
  reviewCards ReviewCard[]

  @@map("users")
}

// ===== 意见反馈表 =====
model Feedback {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  contact   String?  @db.VarChar(200)
  userId    Int?     @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  owner User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("feedback")
}

// ===== 复习卡表 (间隔重复学习系统) =====
// 一张笔记 = 一张卡 (笔记级粒度); [[quiz]] 题目从 Note.content 实时解析, 不单独存表
model ReviewCard {
  id             Int       @id @default(autoincrement())
  noteId         Int       @map("note_id")
  userId         Int       @map("user_id")
  dueDate        DateTime  @map("due_date")              // 哪天该复习 (按日期比较, 不看时分)
  interval       Int       @default(0) @map("interval")  // 当前间隔(天)
  easeFactor     Float     @default(2.5) @map("ease_factor")
  reps           Int       @default(0) @map("reps")       // 连续答对次数
  lastReviewedAt DateTime? @map("last_reviewed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate], name: "idx_user_due") // "今日队列" 高频查询
  @@map("review_cards")
}
