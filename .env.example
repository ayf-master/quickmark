# ==================== QuickMark 环境配置 ====================
# 复制本文件为 .env, 然后填入真实值
# .env 文件在 .gitignore 中, 不会被提交

# ==================== 服务器 ====================
# 应用监听端口
PORT=3000

# ==================== 数据库 (MySQL) ====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=quickmark

# ==================== Prisma ====================
# Prisma 读取的连接串, 与上方 DB_* 字段保持一致
# 密码里有特殊字符 (@, #, %) 必须 URL 编码: @ -> %40, # -> %23, % -> %25
# 例: 密码 ayf#pass -> DATABASE_URL="mysql://root:ayf%23pass@localhost:3306/quickmark"
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/quickmark"

# ==================== 鉴权 (阶段 4) ====================
# JWT 签名密钥, 至少 32 字符, 推荐 48 字节 base64
# 生成方式: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_ISSUER=quickmark
JWT_AUDIENCE=quickmark-web

# 开放注册端点 (1=开放, 默认 0 关闭, 防止恶意注册)
ALLOW_REGISTER=0

# ==================== Redis (可选) ====================
# 缓存层, 不可用时自动降级为直查 MySQL
REDIS_URL=redis://localhost:6379

# ==================== 日志 ====================
# 日志级别: trace / debug / info / warn / error / fatal
# 开发环境默认 debug, 生产环境默认 info
LOG_LEVEL=debug
