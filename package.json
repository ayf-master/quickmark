{
  "name": "quickmark",
  "version": "1.0.0",
  "description": "QuickMark - 轻量级笔记应用",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "init-db": "node db/init.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:status": "prisma migrate status",
    "prisma:dev": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset",
    "prisma:studio": "prisma studio",
    "test": "vitest run",
    "test:pool": "USE_PRISMA=0 node test/integration.js",
    "test:prisma": "USE_PRISMA=1 node test/integration.js",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "markdown-it": "^14.1.0",
    "multer": "^2.2.0",
    "mysql2": "^3.9.0",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.2",
    "happy-dom": "^20.10.6",
    "postcss": "^8.5.15",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "vite": "^5.2.0",
    "vitest": "^4.1.9"
  }
}